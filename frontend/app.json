{
	"expo": {
		"name": "Kratos",
		"slug": "gym-app",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/images/NewIcon.png",
		"scheme": "frontend",
		"userInterfaceStyle": "automatic",
		"ios": {
			"supportsTablet": true,
			"infoPlist": {
				"NSCameraUsageDescription": "Used to scan food barcodes"
			},
			"bundleIdentifier": "com.ethan.forge"
		},
		"android": {
			"adaptiveIcon": {
				"foregroundImage": "./assets/images/adaptive-icon.png",
				"backgroundColor": "#ffffff"
			},
			"permissions": ["android.permission.CAMERA", "android.permission.RECORD_AUDIO"],
			"package": "com.ethan.forge"
		},
		"web": {
			"bundler": "metro",
			"output": "static",
			"favicon": "./assets/images/favicon.png"
		},
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"image": "./assets/images/splash-icon.png",
					"imageWidth": 200,
					"resizeMode": "contain",
					"backgroundColor": "#ffffff"
				}
			],
			"expo-secure-store",
			[
				"expo-camera",
				{
					"cameraPermission": "Allow Kratos to access your camera."
				}
			],
			"@react-native-community/datetimepicker",
			"expo-apple-authentication",
			[
				"react-native-nitro-google-signin",
				{
					"iosUrlScheme": "com.googleusercontent.apps.139225398320-bm60q4js1oblpecgtsdk86s1qj652lg0"
				}
			]
		],
		"experiments": {
			"typedRoutes": true
		},
		"extra": {
			"router": {},
			"eas": {
				"projectId": "f9bb0df0-17d1-4f4c-a5b1-216c3305b399"
			}
		},
		"owner": "ethang420s-team"
	}
}
