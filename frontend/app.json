{
	"expo": {
		"name": "Hearty",
		"slug": "gym-app",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "hearty",
		"userInterfaceStyle": "automatic",
		"ios": {
			"supportsTablet": true,
			"infoPlist": {
				"NSCameraUsageDescription": "Hearty uses your camera to scan barcodes and nutrition labels."
			},
			"bundleIdentifier": "com.ethangordon.hearty"
		},
		"android": {
			"adaptiveIcon": {
				"foregroundImage": "./assets/images/adaptive-icon.png",
				"backgroundColor": "#2F7A4E"
			},
			"permissions": ["android.permission.CAMERA"],
			"package": "com.ethangordon.hearty"
		},
		"web": {
			"bundler": "metro",
			"output": "static",
			"favicon": "./assets/images/favicon.png"
		},
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"image": "./assets/images/splash-icon.png",
					"imageWidth": 200,
					"resizeMode": "contain",
					"backgroundColor": "#F4F7F1"
				}
			],
			"expo-secure-store",
			[
				"expo-camera",
				{
					"cameraPermission": "Allow Hearty to use your camera to scan barcodes and nutrition labels."
				}
			],
			"@react-native-community/datetimepicker",
			"expo-apple-authentication",
			[
				"react-native-nitro-google-signin",
				{
					"iosUrlScheme": "com.googleusercontent.apps.139225398320-bm60q4js1oblpecgtsdk86s1qj652lg0"
				}
			],
			"expo-image",
			"expo-web-browser"
		],
		"experiments": {
			"typedRoutes": true
		},
		"extra": {
			"router": {},
			"eas": {
				"projectId": "f9bb0df0-17d1-4f4c-a5b1-216c3305b399"
			}
		},
		"owner": "ethang420s-team",
		"runtimeVersion": {
			"policy": "fingerprint"
		},
		"updates": {
			"url": "https://u.expo.dev/f9bb0df0-17d1-4f4c-a5b1-216c3305b399"
		}
	}
}
